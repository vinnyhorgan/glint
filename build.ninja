ninja_required_version = 1.7
builddir = build
cc = cc
ar = ar
common_cppflags = -Ivendor/glfw/include -Ivendor/glfw/src -Ivendor/glad/include -D_GLFW_X11 -D_DEFAULT_SOURCE
common_cflags = -std=c11 -ffunction-sections -fdata-sections
app_warnings = -Wall -Wextra -Wpedantic -Werror
vendor_warnings = -w
release_cflags = -Os -DNDEBUG
debug_cflags = -O0 -g3
release_ldflags = -Wl,--gc-sections -Wl,-s
debug_ldflags = 
ldlibs = -lm

rule cc_app
  command = mkdir -p $$(dirname "$out") && $cc $common_cppflags $common_cflags $mode_cflags $app_warnings -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CC $out

rule cc_vendor
  command = mkdir -p $$(dirname "$out") && $cc $common_cppflags $common_cflags $mode_cflags $vendor_warnings -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CC $out

rule ar
  command = mkdir -p $$(dirname "$out") && rm -f $out && $ar rcs $out $in
  description = AR $out

rule link
  command = mkdir -p $$(dirname "$out") && $cc $ldflags $in -o $out $ldlibs
  description = LINK $out

rule clean
  command = rm -rf build
  description = CLEAN build

# release
build build/release/obj/src/main.o: cc_app src/main.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/context.o: cc_vendor vendor/glfw/src/context.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/init.o: cc_vendor vendor/glfw/src/init.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/input.o: cc_vendor vendor/glfw/src/input.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/monitor.o: cc_vendor vendor/glfw/src/monitor.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/platform.o: cc_vendor vendor/glfw/src/platform.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/vulkan.o: cc_vendor vendor/glfw/src/vulkan.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/window.o: cc_vendor vendor/glfw/src/window.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/egl_context.o: cc_vendor vendor/glfw/src/egl_context.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/glx_context.o: cc_vendor vendor/glfw/src/glx_context.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/osmesa_context.o: cc_vendor vendor/glfw/src/osmesa_context.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/null_init.o: cc_vendor vendor/glfw/src/null_init.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/null_joystick.o: cc_vendor vendor/glfw/src/null_joystick.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/null_monitor.o: cc_vendor vendor/glfw/src/null_monitor.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/null_window.o: cc_vendor vendor/glfw/src/null_window.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/linux_joystick.o: cc_vendor vendor/glfw/src/linux_joystick.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/posix_module.o: cc_vendor vendor/glfw/src/posix_module.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/posix_poll.o: cc_vendor vendor/glfw/src/posix_poll.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/posix_thread.o: cc_vendor vendor/glfw/src/posix_thread.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/posix_time.o: cc_vendor vendor/glfw/src/posix_time.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/x11_init.o: cc_vendor vendor/glfw/src/x11_init.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/x11_monitor.o: cc_vendor vendor/glfw/src/x11_monitor.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/x11_window.o: cc_vendor vendor/glfw/src/x11_window.c
  mode_cflags = $release_cflags
build build/release/obj/vendor/glfw/src/xkb_unicode.o: cc_vendor vendor/glfw/src/xkb_unicode.c
  mode_cflags = $release_cflags
build build/release/libglfw_x11.a: ar build/release/obj/vendor/glfw/src/context.o build/release/obj/vendor/glfw/src/init.o build/release/obj/vendor/glfw/src/input.o build/release/obj/vendor/glfw/src/monitor.o build/release/obj/vendor/glfw/src/platform.o build/release/obj/vendor/glfw/src/vulkan.o build/release/obj/vendor/glfw/src/window.o build/release/obj/vendor/glfw/src/egl_context.o build/release/obj/vendor/glfw/src/glx_context.o build/release/obj/vendor/glfw/src/osmesa_context.o build/release/obj/vendor/glfw/src/null_init.o build/release/obj/vendor/glfw/src/null_joystick.o build/release/obj/vendor/glfw/src/null_monitor.o build/release/obj/vendor/glfw/src/null_window.o build/release/obj/vendor/glfw/src/linux_joystick.o build/release/obj/vendor/glfw/src/posix_module.o build/release/obj/vendor/glfw/src/posix_poll.o build/release/obj/vendor/glfw/src/posix_thread.o build/release/obj/vendor/glfw/src/posix_time.o build/release/obj/vendor/glfw/src/x11_init.o build/release/obj/vendor/glfw/src/x11_monitor.o build/release/obj/vendor/glfw/src/x11_window.o build/release/obj/vendor/glfw/src/xkb_unicode.o
build build/glint: link build/release/obj/src/main.o build/release/libglfw_x11.a
  ldflags = $release_ldflags

# debug
build build/debug/obj/src/main.o: cc_app src/main.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/context.o: cc_vendor vendor/glfw/src/context.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/init.o: cc_vendor vendor/glfw/src/init.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/input.o: cc_vendor vendor/glfw/src/input.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/monitor.o: cc_vendor vendor/glfw/src/monitor.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/platform.o: cc_vendor vendor/glfw/src/platform.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/vulkan.o: cc_vendor vendor/glfw/src/vulkan.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/window.o: cc_vendor vendor/glfw/src/window.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/egl_context.o: cc_vendor vendor/glfw/src/egl_context.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/glx_context.o: cc_vendor vendor/glfw/src/glx_context.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/osmesa_context.o: cc_vendor vendor/glfw/src/osmesa_context.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/null_init.o: cc_vendor vendor/glfw/src/null_init.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/null_joystick.o: cc_vendor vendor/glfw/src/null_joystick.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/null_monitor.o: cc_vendor vendor/glfw/src/null_monitor.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/null_window.o: cc_vendor vendor/glfw/src/null_window.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/linux_joystick.o: cc_vendor vendor/glfw/src/linux_joystick.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/posix_module.o: cc_vendor vendor/glfw/src/posix_module.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/posix_poll.o: cc_vendor vendor/glfw/src/posix_poll.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/posix_thread.o: cc_vendor vendor/glfw/src/posix_thread.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/posix_time.o: cc_vendor vendor/glfw/src/posix_time.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/x11_init.o: cc_vendor vendor/glfw/src/x11_init.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/x11_monitor.o: cc_vendor vendor/glfw/src/x11_monitor.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/x11_window.o: cc_vendor vendor/glfw/src/x11_window.c
  mode_cflags = $debug_cflags
build build/debug/obj/vendor/glfw/src/xkb_unicode.o: cc_vendor vendor/glfw/src/xkb_unicode.c
  mode_cflags = $debug_cflags
build build/debug/libglfw_x11.a: ar build/debug/obj/vendor/glfw/src/context.o build/debug/obj/vendor/glfw/src/init.o build/debug/obj/vendor/glfw/src/input.o build/debug/obj/vendor/glfw/src/monitor.o build/debug/obj/vendor/glfw/src/platform.o build/debug/obj/vendor/glfw/src/vulkan.o build/debug/obj/vendor/glfw/src/window.o build/debug/obj/vendor/glfw/src/egl_context.o build/debug/obj/vendor/glfw/src/glx_context.o build/debug/obj/vendor/glfw/src/osmesa_context.o build/debug/obj/vendor/glfw/src/null_init.o build/debug/obj/vendor/glfw/src/null_joystick.o build/debug/obj/vendor/glfw/src/null_monitor.o build/debug/obj/vendor/glfw/src/null_window.o build/debug/obj/vendor/glfw/src/linux_joystick.o build/debug/obj/vendor/glfw/src/posix_module.o build/debug/obj/vendor/glfw/src/posix_poll.o build/debug/obj/vendor/glfw/src/posix_thread.o build/debug/obj/vendor/glfw/src/posix_time.o build/debug/obj/vendor/glfw/src/x11_init.o build/debug/obj/vendor/glfw/src/x11_monitor.o build/debug/obj/vendor/glfw/src/x11_window.o build/debug/obj/vendor/glfw/src/xkb_unicode.o
build build/glint-debug: link build/debug/obj/src/main.o build/debug/libglfw_x11.a
  ldflags = $debug_ldflags

build build/release: phony build/glint
build build/debug: phony build/glint-debug
build release: phony build/glint
build debug: phony build/glint-debug
build all: phony build/glint build/glint-debug
build clean: clean
default build/glint

